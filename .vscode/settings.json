{
   "files.exclude": {
      "**/flutter/ephemeral": true,
      "**/Flutter/ephemeral": true,
      "**/.symlinks": true,
      "**/.plugin_symlinks": true,
      "package-lock.json": true,
      "postcss.config.mjs": true,
      "react-native-css-env.d.ts": true,
      "README.md": true,
      "CLAUDE.md": true,
      "expo-env.d.ts": true,
      "LICENSE": true,
      "metro.config.js": true,
      "nativewind-env.d.ts": true,
      ".env": true,
      ".gitignore": true,
      ".npmrc": true,
      "AGENTS.md": true,
      "example": true,
      ".vscode": true,
      ".expo": true,
      ".claude": true,
      "node_modules": true,
      "assets": true
   },
   "editor.codeActionsOnSave": {
      "source.organizeImports": "never",
      "source.removeUnused.ts": "never",
      "source.addMissingImports.ts": "never",
      "source.fixAll.eslint": "never",
      "source.removeUnusedImports": "never"
   },
   "eslint.codeActionsOnSave.mode": "problems",
   "files.watcherExclude": {
    "**/node_modules/**": true,
    "**/.expo/**": true,
    "**/android/**": true,
    "**/ios/**": true
  }
}
