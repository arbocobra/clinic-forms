{
   "extends": "expo/tsconfig.base",
   "compilerOptions": {
      "strict": true,
      "noImplicitAny": false,
      "paths": {
         "@/*": ["./*"],
         "@/app/*": ["./src/app/*"],
         "@/components/*": ["./src/components/*"],
         "@/gluestack/*": ["./components/ui/*"]
      }
   },
   "include": ["**/*.ts", "**/*.tsx", ".expo/types/**/*.ts", "expo-env.d.ts", "nativewind-env.d.ts"]
}
