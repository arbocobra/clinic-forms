{
   "extends": "expo/tsconfig.base",
   "compilerOptions": {
      "strict": true,
      "noImplicitAny": false,
      "paths": {
         "@/*": ["./src/*"],
         "@components/*": ["./src/components/*"],
         "@features/*": ["./src/features/*"],
         "@ui/*": ["./components/ui/*"]
      }
   },
   "include": ["**/*.ts", "**/*.tsx", ".expo/types/**/*.ts", "expo-env.d.ts", "nativewind-env.d.ts", "src/types/global.d.ts"],
   "exclude": [
    "node_modules",
    ".expo",
    "export",
    "web-build",
    "android",
    "ios"
  ]
}
